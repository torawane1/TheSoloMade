generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id            String    @id @default(cuid())
  name          String     @unique
  tag           String
  logo          String?
  region        String
  foundingDate  DateTime?
  socialLinks   String?   // Stored as JSON string
  achievements  Achievement[]
  players       Player[]
  tournamentParticipation TournamentParticipation[]
  rosterHistory RosterHistory[]
  awards        Award[]
  isDisbanded   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("organizations")
}

model Player {
  id            String    @id @default(cuid())
  ign           String    @unique
  realName      String?
  photo         String?
  role          String    // ASSAULTER, SUPPORT, SNIPER, IGL
  currentTeamId String?
  currentTeam   Organization? @relation(fields: [currentTeamId], references: [id])
  pastTeams     RosterHistory[]
  nationality   String
  socials       String?   // Stored as JSON string
  
  // Career aggregate stats
  totalKills    Int       @default(0)
  totalDamage   Int       @default(0)
  totalMVPs     Int       @default(0)
  kda           Float     @default(0.0)

  matchStats    MatchPlayerStat[]
  awards        Award[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("players")
}

model RosterHistory {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String
  team      Organization @relation(fields: [teamId], references: [id])
  joinDate  DateTime
  leaveDate DateTime?
  
  @@map("roster_history")
}

model Tournament {
  id            String    @id @default(cuid())
  name          String
  organizer     String
  tier          String    // S, A, B
  format        String    // LEAGUE, PLAYOFFS, LAN
  prizePool     String?
  startDate     DateTime
  endDate       DateTime?
  region        String
  status        String    @default("UPCOMING") // UPCOMING, LIVE, COMPLETED
  
  // Point system configuration (JSON string)
  pointsSystem  String    
  
  matches       Match[]
  participations TournamentParticipation[]
  awards        Award[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("tournaments")
}

model TournamentParticipation {
  id           String       @id @default(cuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  
  totalPoints  Int          @default(0)
  totalKills    Int          @default(0)
  rank          Int?

  @@unique([tournamentId, orgId])
  @@map("tournament_participations")
}

model Match {
  id           String    @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  mapPlayed    String
  matchDate    DateTime  @default(now())
  
  teamResults  MatchTeamResult[]
  playerStats  MatchPlayerStat[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("matches")
}

model MatchTeamResult {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id])
  orgId         String
  placement     Int
  killPoints    Int
  totalPoints   Int
  
  @@unique([matchId, orgId])
  @@map("match_team_results")
}

model MatchPlayerStat {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  kills     Int      @default(0)
  damage    Int      @default(0)
  survival  Int      @default(0)
  isMVP     Boolean  @default(false)

  @@unique([matchId, playerId])
  @@map("match_player_stats")
}

model Achievement {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  title          String
  description    String?
  date           DateTime
  
  @@map("achievements")
}

model Award {
  id           String     @id @default(cuid())
  title        String
  playerId     String?
  player       Player?    @relation(fields: [playerId], references: [id])
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  year         Int
  createdAt    DateTime   @default(now())

  @@map("awards")
}
